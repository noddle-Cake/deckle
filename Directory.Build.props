<Project>
  <PropertyGroup>
    <!-- net10.0: FluentAvalonia 3 (for Avalonia 12) targets only .NET 10. -->
    <ScanwiseTargetFramework>net10.0</ScanwiseTargetFramework>
    <TargetFramework>$(ScanwiseTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Authors>Chris Servin</Authors>
    <Product>Scanwise</Product>
    <Copyright>Copyright © 2026 Chris Servin</Copyright>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
  </PropertyGroup>
  <PropertyGroup>
    <Naps2Version>1.6.0</Naps2Version>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
  </PropertyGroup>
</Project>
