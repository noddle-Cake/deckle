<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:svc="using:Deckle.App.Services">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PaneBackground" Color="#F3F0E6" />
          <!-- Scan options pane and editor bar; MacStyles makes them transparent over the window's vibrancy. -->
          <SolidColorBrush x:Key="SidebarBackground" Color="#F3F0E6" />
          <SolidColorBrush x:Key="BarBackground" Color="#F3F0E6" />
          <!-- Behind pages and editor in the macOS shell. -->
          <SolidColorBrush x:Key="ContentBackground" Color="#FFFDF8" />
          <!-- Edge of windows that draw their own frame (ClientDecorations). -->
          <SolidColorBrush x:Key="WindowBorder" Color="#33000000" />
          <SolidColorBrush x:Key="HeaderBarBackground" Color="#E9E5D8" />
          <SolidColorBrush x:Key="CardBackground" Color="#FBF9F2" />
          <SolidColorBrush x:Key="CardBorder" Color="#1A000000" />
          <SolidColorBrush x:Key="CanvasBackground" Color="#E9E5D8" />
          <SolidColorBrush x:Key="PageShadow" Color="#33000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PaneBackground" Color="#1B2220" />
          <SolidColorBrush x:Key="SidebarBackground" Color="#1B2220" />
          <SolidColorBrush x:Key="BarBackground" Color="#1B2220" />
          <SolidColorBrush x:Key="ContentBackground" Color="#181E1C" />
          <SolidColorBrush x:Key="WindowBorder" Color="#59FFFFFF" />
          <SolidColorBrush x:Key="HeaderBarBackground" Color="#26302D" />
          <SolidColorBrush x:Key="CardBackground" Color="#26302D" />
          <SolidColorBrush x:Key="CardBorder" Color="#19FFFFFF" />
          <SolidColorBrush x:Key="CanvasBackground" Color="#141A18" />
          <SolidColorBrush x:Key="PageShadow" Color="#66000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Section headings in the scan options pane (Scanner's BaseTextBlockStyle). -->
  <!-- The Fluent theme styles Button.accent but not SplitButton.accent; Scan is the one action that should stand out. -->
  <Style Selector="SplitButton.accent:not(:disabled) /template/ Button">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>
  <Style Selector="SplitButton.accent:not(:disabled) /template/ Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
  </Style>
  <Style Selector="SplitButton.accent:not(:disabled) /template/ Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.heading">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Divider on the scan options pane's trailing edge (a style, so the macOS glass sidebar can drop it). -->
  <Style Selector="Border.sidebar">
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <!-- Rounded cards like Scanner's option groups. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <!-- Compact icon-only toolbar buttons. -->
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icon ui|FAFontIcon">
    <Setter Property="FontSize" Value="18" />
  </Style>

  <!-- Icon-only buttons are named after their tooltip for screen readers; a local AutomationProperties.Name wins. -->
  <Style Selector=":is(Button).icon">
    <Setter Property="AutomationProperties.Name"
            Value="{Binding $self.(ToolTip.Tip), Converter={x:Static svc:AccessibleName.Instance}}" />
  </Style>
  <Style Selector="ListBox.pages ListBoxItem">
    <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Label}" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem">
    <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Label}" />
  </Style>

  <Style Selector="RadioButton">
    <Setter Property="Margin" Value="0,0,0,-4" />
  </Style>

  <!-- Thumbnail tiles in the page list. -->
  <Style Selector="ListBox.pages ListBoxItem">
    <Setter Property="Padding" Value="6" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem">
    <Setter Property="Padding" Value="5" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
</Styles>
