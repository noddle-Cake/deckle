<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Deckle.App.Views">

  <!--
    GNOME look only (added in App.axaml.cs after ToolbarLookStyles.axaml): libadwaita's colours and shapes, so the
    window sits with GNOME apps. Sidebar and header bar share one shade, the content area is the "view" colour,
    boxed lists (our cards) have 12 px corners. The accent colour comes from GNOME's setting (App.axaml.cs).
  -->

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SidebarBackground" Color="#E9E5D8" />
          <SolidColorBrush x:Key="HeaderBarBackground" Color="#E9E5D8" />
          <SolidColorBrush x:Key="BarBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ContentBackground" Color="#FFFDF8" />
          <SolidColorBrush x:Key="PaneBackground" Color="#F8F5EC" />
          <SolidColorBrush x:Key="CanvasBackground" Color="#F8F5EC" />
          <SolidColorBrush x:Key="CardBackground" Color="#FFFDF8" />
          <SolidColorBrush x:Key="CardBorder" Color="#1F000006" />
          <SolidColorBrush x:Key="WindowBorder" Color="#33000006" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SidebarBackground" Color="#26302D" />
          <SolidColorBrush x:Key="HeaderBarBackground" Color="#26302D" />
          <SolidColorBrush x:Key="BarBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ContentBackground" Color="#181E1C" />
          <SolidColorBrush x:Key="PaneBackground" Color="#1D2422" />
          <SolidColorBrush x:Key="CanvasBackground" Color="#1D2422" />
          <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF0F" />
          <SolidColorBrush x:Key="CardBorder" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="WindowBorder" Color="#59FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Boxed lists (GNOME preferences rows) have 12 px corners. -->
  <Style Selector="Border.card">
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <!-- The sidebar sits in the split view without a divider line; the colour change separates it. -->
  <Style Selector="v|GnomeShell Border.sidebar">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
</Styles>
