<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Deckle.App.Views"
        x:Class="Deckle.App.Views.HelpWindow"
        Title="Deckle Help"
        Width="760" Height="720" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
  <!-- macOS only: Help ▸ Deckle Help opens this window instead of replacing the workspace. -->
  <v:HelpView />
</Window>
