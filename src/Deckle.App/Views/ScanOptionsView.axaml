<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:Deckle.App.Controls"
             xmlns:vm="using:Deckle.App.ViewModels"
             xmlns:svc="using:Deckle.App.Services"
             xmlns:scan="using:Deckle.Core.Scanning"
             x:Class="Deckle.App.Views.ScanOptionsView"
             x:DataType="vm:MainViewModel">
  <Border Classes="sidebar" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource CardBorder}">
    <Grid RowDefinitions="Auto,*,Auto" DataContext="{Binding ScanOptions}" x:DataType="vm:ScanOptionsViewModel">

      <!-- Header: profile picker -->
      <Grid Grid.Row="0" Margin="16,14,12,6" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="title" Text="Scan" IsVisible="{x:Static svc:PlatformLook.NotGnome}" /> <!-- GNOME: the sidebar header says it. -->
          <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}"
                    HorizontalAlignment="Stretch" ToolTip.Tip="Scan profile: a saved set of scan options" />
        </StackPanel>
        <Button Grid.Column="1" Classes="icon" VerticalAlignment="Bottom" Margin="4,0,0,0" ToolTip.Tip="Profile options">
          <c:LucideIcon Kind="Ellipsis" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Save as new profile…" Command="{Binding SaveProfileAsCommand}" />
              <MenuItem Header="Rename profile…" Command="{Binding RenameProfileCommand}" />
              <MenuItem Header="Delete profile" Command="{Binding DeleteProfileCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,6,16,16" Spacing="18">

          <!-- Scanner -->
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="heading" Text="Scanner" />
              <Button Grid.Column="1" Classes="icon" Padding="4" Command="{Binding RefreshScannersCommand}" ToolTip.Tip="Search for scanners again">
                <c:LucideIcon Kind="RefreshCw" FontSize="14" />
              </Button>
            </Grid>
            <ComboBox ItemsSource="{Binding Scanners}" SelectedItem="{Binding SelectedScanner}" HorizontalAlignment="Stretch"
                      PlaceholderText="No scanner selected">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="scan:DiscoveredScanner">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DriverLabel}" Classes="caption" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSearching}">
              <ui:FAProgressRing Width="16" Height="16" IsIndeterminate="True" />
              <TextBlock Classes="caption" Text="Searching for scanners, including network scanners…" VerticalAlignment="Center" />
            </StackPanel>
            <Border Classes="card" IsVisible="{Binding NoScannerFound}">
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="No scanner found" />
                <TextBlock Classes="caption" Text="Make sure the scanner is turned on and connected by USB or to the same network, then search again. See Help for driver tips." />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Source -->
          <StackPanel Spacing="2">
            <TextBlock Classes="heading" Text="Source" />
            <RadioButton GroupName="source" Content="Automatic" IsChecked="{Binding IsAuto}" />
            <RadioButton GroupName="source" Content="Flatbed (glass)" IsChecked="{Binding IsFlatbed}" IsEnabled="{Binding FlatbedSupported}" />
            <RadioButton GroupName="source" Content="Document feeder" IsChecked="{Binding IsFeeder}" IsEnabled="{Binding FeederSupported}" />
            <CheckBox Margin="28,2,0,0" Content="Both sides (duplex)" IsChecked="{Binding Duplex}"
                      IsVisible="{Binding IsFeeder}" IsEnabled="{Binding DuplexSupported}" />
            <!-- Only scanners whose feeder sensor can be read (eSCL, WIA, some SANE backends) enable this. -->
            <CheckBox x:Name="ScanWhenPaperLoadedBox" Margin="0,6,0,0" IsChecked="{Binding ScanWhenPaperLoaded}"
                      IsVisible="{Binding FeederSupported}" IsEnabled="{Binding CanScanWhenPaperLoaded}">
              <StackPanel>
                <TextBlock Text="Scan when paper is loaded" />
                <TextBlock Classes="caption" Text="{Binding PaperSensorHint}" />
              </StackPanel>
            </CheckBox>
          </StackPanel>

          <!-- Format -->
          <StackPanel Spacing="6">
            <TextBlock Classes="heading" Text="File format" />
            <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" HorizontalAlignment="Stretch" />
            <TextBlock Classes="caption" Text="{Binding Format.Description}" />
          </StackPanel>

          <!-- Color -->
          <StackPanel Spacing="2">
            <TextBlock Classes="heading" Text="Color" />
            <RadioButton GroupName="color" Content="Color" IsChecked="{Binding IsColor}" IsEnabled="{Binding ColorSupported}" />
            <RadioButton GroupName="color" Content="Grayscale" IsChecked="{Binding IsGrayscale}" IsEnabled="{Binding GrayscaleSupported}" />
            <RadioButton GroupName="color" Content="Black and white" IsChecked="{Binding IsBlackAndWhite}" IsEnabled="{Binding BlackAndWhiteSupported}" />
          </StackPanel>

          <!-- Resolution -->
          <StackPanel Spacing="6">
            <TextBlock Classes="heading" Text="Resolution" />
            <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding StringFormat='{}{0} dpi'}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="caption" Text="{Binding ResolutionHint}" />
          </StackPanel>

          <!-- More options -->
          <Expander Header="More options" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">
              <StackPanel Spacing="6">
                <TextBlock Classes="heading" Text="Page size" />
                <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" HorizontalAlignment="Stretch" />
                <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding IsCustomPageSize}">
                  <ui:FANumberBox Header="Width (mm)" Value="{Binding CustomWidthMm}" Minimum="10" Maximum="2000" />
                  <ui:FANumberBox Grid.Column="2" Header="Height (mm)" Value="{Binding CustomHeightMm}" Minimum="10" Maximum="2000" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Classes="heading" Text="Brightness" />
                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding BrightnessLabel}" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Classes="icon" Padding="4" Command="{Binding ResetBrightnessCommand}" ToolTip.Tip="Reset">
                    <c:LucideIcon Kind="Undo2" FontSize="14" />
                  </Button>
                </Grid>
                <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}" TickFrequency="10" IsSnapToTickEnabled="False" />
              </StackPanel>

              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Classes="heading" Text="Contrast" />
                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding ContrastLabel}" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Classes="icon" Padding="4" Command="{Binding ResetContrastCommand}" ToolTip.Tip="Reset">
                    <c:LucideIcon Kind="Undo2" FontSize="14" />
                  </Button>
                </Grid>
                <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="heading" Text="Processing" />
                <CheckBox IsChecked="{Binding AutoDeskew}">
                  <StackPanel>
                    <TextBlock Text="Straighten crooked pages" />
                    <TextBlock Classes="caption" Text="Fixes small tilts. Upside-down and sideways pages are fixed by auto-rotate (Settings)." />
                  </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{Binding ExcludeBlankPages}">
                  <StackPanel>
                    <TextBlock Text="Skip blank pages" />
                    <TextBlock Classes="caption" Text="Useful for double-sided documents with empty backs." />
                  </StackPanel>
                </CheckBox>
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding HasRegion}">
                <TextBlock Classes="heading" Text="Scan area" />
                <TextBlock Classes="caption" Text="Flatbed scans use the area chosen in the preview." />
                <Button Content="Scan the whole page again" Command="{Binding ClearRegionCommand}" />
              </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>

      <!-- Action bar -->
      <Border Grid.Row="2" Padding="16,12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0"
              DataContext="{Binding $parent[UserControl].((vm:MainViewModel)DataContext)}" x:DataType="vm:MainViewModel">
        <Grid ColumnDefinitions="Auto,*">
          <Button x:Name="PreviewButton" Grid.Column="0" Margin="0,0,8,0" Command="{Binding PreviewCommand}" IsEnabled="{Binding ScanOptions.CanPreview}"
                  ToolTip.Tip="Quick preview of the glass; select the area to scan">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:LucideIcon Kind="Crop" FontSize="16" />
              <TextBlock Text="Preview" />
            </StackPanel>
          </Button>
          <!-- macOS: Scan is the toolbar's primary button (one primary action per window). -->
          <SplitButton Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                       IsVisible="{x:Static svc:PlatformLook.IsWindows}"
                       Classes="accent" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}"
                       ToolTip.Tip="{svc:ShortcutTip Scan, Scan}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:LucideIcon Kind="ScanLine" FontSize="16" />
              <TextBlock Text="Scan" FontWeight="SemiBold" />
            </StackPanel>
            <SplitButton.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedRight">
                <MenuItem Header="Scan and add to current document" Command="{Binding ScanAddToDocumentCommand}" />
                <MenuItem Header="Scan into a new document" Command="{Binding ScanStartFreshCommand}" InputGesture="{svc:Shortcut ScanNew}" />
                <MenuItem Header="Scan and insert between pages…" Command="{Binding ScanMergeCommand}" />
                <Separator />
                <MenuItem Header="Batch scan…" Command="{Binding BatchScanCommand}" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
