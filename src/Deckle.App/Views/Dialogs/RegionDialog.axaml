<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Deckle.App.Controls"
             x:Class="Deckle.App.Views.Dialogs.RegionDialog">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left">
      Drag to choose the part of the glass to scan. The area is used for flatbed scans until you clear it.
    </TextBlock>
    <Viewbox x:Name="Box" MaxWidth="560" MaxHeight="560" Stretch="Uniform">
      <Grid x:Name="Surface">
        <Image x:Name="PreviewImage" Stretch="Fill" />
        <c:CropOverlay x:Name="Overlay" />
      </Grid>
    </Viewbox>
  </DockPanel>
</UserControl>
