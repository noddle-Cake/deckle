<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:Deckle.App.Controls"
        xmlns:vm="using:Deckle.App.ViewModels"
        xmlns:v="using:Deckle.App.Views"
        x:Class="Deckle.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/deckle.ico"
        Width="1320" Height="860" MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <!-- Key bindings are added in code from AppShortcuts (⌘ on macOS, Ctrl elsewhere). -->

  <ui:FANavigationView x:Name="Nav"
                     PaneDisplayMode="LeftCompact"
                     IsPaneToggleButtonVisible="False"
                     IsSettingsVisible="False"
                     IsBackButtonVisible="False"
                     OpenPaneLength="220"
                     CompactPaneLength="56">
    <ui:FANavigationView.MenuItems>
      <ui:FANavigationViewItem x:Name="NavScan" Content="Scan" Tag="Scan" IconSource="{c:LucideSource ScanLine}" ToolTip.Tip="Scan options" />
      <ui:FANavigationViewItem x:Name="NavPages" Content="Pages" Tag="Pages" IconSource="{c:LucideSource Files}" ToolTip.Tip="Pages">
        <ui:FANavigationViewItem.InfoBadge>
          <ui:FAInfoBadge Value="{Binding Pages.Count}" IsVisible="{Binding HasPages}" />
        </ui:FANavigationViewItem.InfoBadge>
      </ui:FANavigationViewItem>
      <ui:FANavigationViewItem x:Name="NavEditor" Content="Edit" Tag="Editor" IconSource="{c:LucideSource Image}" ToolTip.Tip="Edit page"
                             IsVisible="{Binding ShowEditorNavItem}" />
    </ui:FANavigationView.MenuItems>
    <ui:FANavigationView.FooterMenuItems>
      <ui:FANavigationViewItem x:Name="NavFolder" Content="Open save folder" Tag="Folder" IconSource="{c:LucideSource FolderOpen}" SelectsOnInvoked="False"
                             ToolTip.Tip="Open the folder where scans are saved" />
      <ui:FANavigationViewItem x:Name="NavHelp" Content="Help" Tag="Help" IconSource="{c:LucideSource CircleHelp}" ToolTip.Tip="Help" />
      <ui:FANavigationViewItem x:Name="NavSettings" Content="Settings" Tag="Settings" IconSource="{c:LucideSource Settings}" ToolTip.Tip="Settings" />
    </ui:FANavigationView.FooterMenuItems>

    <Grid RowDefinitions="Auto,Auto,*">
      <!-- Progress for scans, saves and imports. -->
      <Border x:Name="BusyBar" Grid.Row="0" IsVisible="{Binding IsBusy}" Padding="16,8" Background="{DynamicResource PaneBackground}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding BusyText}" FontWeight="SemiBold" />
            <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding Progress}" Maximum="100" />
          </StackPanel>
          <Button Grid.Column="1" Margin="12,0,0,0" Content="Cancel" Command="{Binding CancelOperationCommand}"
                  IsVisible="{Binding CanCancel}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <ui:FAInfoBar Grid.Row="1" Margin="12,8,12,0"
                  IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
                  Title="{Binding StatusTitle}"
                  Message="{Binding StatusMessage}"
                  Severity="{Binding StatusSeverity}"
                  IsClosable="True">
        <ui:FAInfoBar.ActionButton>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Open" Command="{Binding OpenLastSavedCommand}" IsVisible="{Binding StatusHasFileActions}" />
            <Button Content="{OnPlatform 'Show in folder', macOS='Show in Finder'}" Command="{Binding ShowLastSavedInFolderCommand}" IsVisible="{Binding StatusHasFileActions}" />
            <Button Content="Clear Pages…" Command="{Binding ClearAllCommand}" IsVisible="{Binding StatusCanClear}" />
          </StackPanel>
        </ui:FAInfoBar.ActionButton>
      </ui:FAInfoBar>

      <!-- Workspace: scan options | pages | editor. Column widths are set from code for each layout. -->
      <Grid Grid.Row="2" x:Name="Workspace" IsVisible="{Binding IsWorkspace}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="340" />
          <ColumnDefinition Width="260" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <v:ScanOptionsView Grid.Column="0" x:Name="ScanPane" DataContext="{Binding}" IsVisible="{Binding ShowScanPane}" />
        <v:PageListView Grid.Column="1" x:Name="PagesPane" DataContext="{Binding}" IsVisible="{Binding ShowPagesPane}" />
        <v:EditorView Grid.Column="2" x:Name="EditorPane" DataContext="{Binding}" IsVisible="{Binding ShowEditorPane}" />
      </Grid>

      <Panel Grid.Row="2" IsVisible="{Binding ShowSettings}">
        <v:SettingsView DataContext="{Binding SettingsPage}" />
      </Panel>
      <v:HelpView Grid.Row="2" IsVisible="{Binding ShowHelp}" />
    </Grid>
  </ui:FANavigationView>
</Window>
