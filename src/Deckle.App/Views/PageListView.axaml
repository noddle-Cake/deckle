<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:Deckle.App.Controls"
             xmlns:vm="using:Deckle.App.ViewModels"
             xmlns:svc="using:Deckle.App.Services"
             x:Class="Deckle.App.Views.PageListView"
             x:DataType="vm:MainViewModel">
  <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <Grid Grid.Row="0" Margin="14,14,8,4" ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="title" Text="Pages" />
          <TextBlock Classes="caption" Text="{Binding Pages.SelectionSummary}" />
        </StackPanel>
        <!-- On macOS undo/redo live in the Edit menu, and the common page actions in the window toolbar. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" IsVisible="{x:Static svc:PlatformLook.HasPaneActions}">
          <Button Classes="icon" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="{svc:ShortcutTip Undo, Undo}">
            <c:LucideIcon Kind="Undo2" />
          </Button>
          <Button Classes="icon" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip.Tip="{svc:ShortcutTip Redo, Redo}">
            <c:LucideIcon Kind="Redo2" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Toolbar: acts on the selection, or on all pages when nothing is selected. -->
      <WrapPanel Grid.Row="1" Margin="8,0,8,4">
        <Button Classes="icon" Command="{Binding ImportCommand}" ToolTip.Tip="{svc:ShortcutTip 'Import images or PDFs', Import}">
          <c:LucideIcon Kind="Import" />
        </Button>
        <Button Classes="icon" Command="{Binding Pages.RotateLeftCommand}" IsEnabled="{Binding HasPages}" ToolTip.Tip="Rotate left"
                IsVisible="{x:Static svc:PlatformLook.HasPaneActions}">
          <c:LucideIcon Kind="RotateCcw" />
        </Button>
        <Button Classes="icon" Command="{Binding Pages.RotateRightCommand}" IsEnabled="{Binding HasPages}" ToolTip.Tip="Rotate right"
                IsVisible="{x:Static svc:PlatformLook.HasPaneActions}">
          <c:LucideIcon Kind="RotateCw" />
        </Button>
        <Button Classes="icon" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding Pages.HasSelection}" ToolTip.Tip="{svc:ShortcutTip 'Delete selected pages', Delete}">
          <c:LucideIcon Kind="Trash2" />
        </Button>
        <Button Classes="icon" Command="{Binding SaveAsCommand}" IsEnabled="{Binding HasPages}" ToolTip.Tip="{svc:ShortcutTip 'Save as…', SaveAs}"
                IsVisible="{x:Static svc:PlatformLook.HasPaneActions}">
          <c:LucideIcon Kind="FileOutput" />
        </Button>
        <Button Classes="icon" Command="{Binding CopyPageCommand}" IsEnabled="{Binding Pages.HasSelection}" ToolTip.Tip="{svc:ShortcutTip 'Copy page to clipboard', Copy}"
                IsVisible="{x:Static svc:PlatformLook.HasPaneActions}">
          <c:LucideIcon Kind="Copy" />
        </Button>
        <Button Classes="icon" Command="{Binding ShareCommand}" IsEnabled="{Binding HasPages}" ToolTip.Tip="{svc:ShortcutTip 'Share selected pages, or all pages', Share}"
                IsVisible="{x:Static svc:PlatformLook.HasPaneActions}">
          <c:LucideIcon Kind="Share" />
        </Button>
        <Button Classes="icon" ToolTip.Tip="More page actions" IsEnabled="{Binding HasPages}">
          <c:LucideIcon Kind="Ellipsis" />
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Save" Command="{Binding SaveCommand}" InputGesture="{svc:Shortcut Save}" />
              <MenuItem Header="Save selected pages as…" Command="{Binding SaveSelectionAsCommand}" IsEnabled="{Binding Pages.HasSelection}" />
              <MenuItem Header="Open selected page in another app" Command="{Binding OpenSelectedExternallyCommand}" IsEnabled="{Binding Pages.HasSelection}" />
              <MenuItem Header="Copy page to clipboard" Command="{Binding CopyPageCommand}" IsEnabled="{Binding Pages.HasSelection}" InputGesture="{svc:Shortcut Copy}" />
              <MenuItem Header="Share…" Command="{Binding ShareCommand}" InputGesture="{svc:Shortcut Share}" />
              <Separator />
              <MenuItem Header="Select all" Command="{Binding Pages.SelectAllCommand}" InputGesture="{svc:Shortcut SelectAll}" />
              <MenuItem Header="Rotate 180°" Command="{Binding Pages.Rotate180Command}" />
              <MenuItem Header="Duplicate" Command="{Binding Pages.DuplicateCommand}" IsEnabled="{Binding Pages.HasSelection}" />
              <MenuItem Header="Move up" Command="{Binding Pages.MoveUpCommand}" IsEnabled="{Binding Pages.HasSelection}" />
              <MenuItem Header="Move down" Command="{Binding Pages.MoveDownCommand}" IsEnabled="{Binding Pages.HasSelection}" />
              <MenuItem Header="Undo edits on page" Command="{Binding Pages.ResetEditsCommand}" />
              <Separator />
              <MenuItem Header="Page order">
                <MenuItem Header="Reverse" Command="{Binding Pages.ReverseCommand}" />
                <MenuItem Header="Interleave (fronts, then backs)" Command="{Binding Pages.InterleaveCommand}" />
                <MenuItem Header="Interleave (fronts, then backs reversed)" Command="{Binding Pages.AltInterleaveCommand}" />
                <MenuItem Header="Deinterleave" Command="{Binding Pages.DeinterleaveCommand}" />
                <MenuItem Header="Deinterleave (backs reversed)" Command="{Binding Pages.AltDeinterleaveCommand}" />
              </MenuItem>
              <Separator />
              <MenuItem Header="Clear all pages…" Command="{Binding ClearAllCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </WrapPanel>

      <ListBox Grid.Row="2" x:Name="List" Classes="pages"
               ItemsSource="{Binding Pages.Items}"
               SelectedItems="{Binding Pages.SelectedItems}"
               SelectionMode="Multiple"
               Background="Transparent"
               DragDrop.AllowDrop="True"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PageItemViewModel">
            <StackPanel Spacing="6" Width="200" ToolTip.Tip="{Binding Tooltip}">
              <Border Height="220" Background="Transparent">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        BoxShadow="0 1 4 0 #40000000" Background="White">
                  <Panel>
                    <Image Source="{Binding Thumbnail}" MaxWidth="196" MaxHeight="216" Stretch="Uniform" />
                    <ui:FAProgressRing Width="24" Height="24" IsIndeterminate="True" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" Margin="60" />
                  </Panel>
                </Border>
              </Border>
              <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Classes="caption" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Rotate left" Command="{Binding Pages.RotateLeftCommand}" />
            <MenuItem Header="Rotate right" Command="{Binding Pages.RotateRightCommand}" />
            <MenuItem Header="Rotate 180°" Command="{Binding Pages.Rotate180Command}" />
            <Separator />
            <MenuItem Header="Duplicate" Command="{Binding Pages.DuplicateCommand}" />
            <MenuItem Header="Move up" Command="{Binding Pages.MoveUpCommand}" />
            <MenuItem Header="Move down" Command="{Binding Pages.MoveDownCommand}" />
            <Separator />
            <MenuItem Header="Save selected pages as…" Command="{Binding SaveSelectionAsCommand}" />
            <MenuItem Header="Open in another app" Command="{Binding OpenSelectedExternallyCommand}" />
            <MenuItem Header="Copy to clipboard" Command="{Binding CopyPageCommand}" InputGesture="{svc:Shortcut Copy}" />
            <MenuItem Header="Share…" Command="{Binding ShareCommand}" InputGesture="{svc:Shortcut Share}" />
            <Separator />
            <MenuItem Header="Delete" Command="{Binding DeleteSelectedCommand}" InputGesture="{svc:Shortcut Delete}" />
          </ContextMenu>
        </ListBox.ContextMenu>
      </ListBox>

      <!-- Empty state (Scanner's "Your scans will appear here"). -->
      <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="24"
                  IsVisible="{Binding !HasPages}">
        <c:LucideIcon Kind="Files" FontSize="40" Opacity="0.5" />
        <TextBlock Text="Your scans will appear here" HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
        <TextBlock Classes="caption" TextAlignment="Center" MaxWidth="220"
                   Text="Scan a page, or drop images and PDFs here to import them." />
      </StackPanel>

      <Border Grid.Row="3" Padding="12,8" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" IsVisible="{Binding HasPages}">
        <Button HorizontalAlignment="Stretch" Command="{Binding SaveCommand}" ToolTip.Tip="{svc:ShortcutTip 'Save all pages', Save}">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <c:LucideIcon Kind="Save" FontSize="16" />
            <TextBlock Text="Save" />
          </StackPanel>
        </Button>
      </Border>
    </Grid>
  </Border>
</UserControl>
