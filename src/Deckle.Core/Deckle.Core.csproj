<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Deckle.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- ImageSharp 3.1.12 advisories stay visible as warnings; see docs/SECURITY-NOTES.md. 3.2+ needs a Six Labors license key. -->
    <WarningsNotAsErrors>NU1902;NU1903</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAPS2.Sdk" Version="$(Naps2Version)" />
    <PackageReference Include="NAPS2.Images.ImageSharp" Version="$(Naps2Version)" />
    <PackageReference Include="NAPS2.Pdfium.Binaries" Version="1.3.0" />
    <PackageReference Include="NAPS2.Tesseract.Binaries" Version="1.4.0" />
    <PackageReference Include="NAPS2.Sane.Binaries" Version="1.2.3" />
    <PackageReference Include="NAPS2.Sdk.Worker.Win32" Version="$(Naps2Version)" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deckle.Core.Tests" />
  </ItemGroup>

</Project>
