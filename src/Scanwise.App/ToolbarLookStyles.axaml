<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls">

  <!--
    Shared by the macOS and GNOME looks (added in App.axaml.cs; PlatformLook.IsToolbarLook): flat toolbar/header
    bar buttons and the confirming button last in dialogs. MacStyles.axaml and GnomeStyles.axaml add the rest.
  -->

  <!-- Toolbar and header bar items have no bezel (Apple Toolbars HIG; GNOME: buttons "should appear flat"). -->
  <Style Selector="ToggleButton.icon">
    <Setter Property="Padding" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.icon ui|FAFontIcon">
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style Selector=":is(Button).icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- A toggled toolbar button is a subtle grey, not an accent-filled block. -->
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <!-- Pages | Editor switch in the toolbar or header bar. -->
  <Style Selector="ToggleButton.segment">
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!--
    Dialog buttons: Apple ("Always place the default button on the trailing side of a row … Cancel buttons are
    typically on the leading side") and libadwaita alert dialogs both put the confirming button last.
    FluentAvalonia's ContentDialog uses the Windows order (Primary · Secondary · Close), so this mirrors its
    CommandSpace grid (columns *, 0.5*, 0.5*, *) to Close · Secondary · Primary. Three-button rules come last so
    they win over the two-button ones.
  -->

  <Style Selector="ui|FAContentDialog:primary:close /template/ Button#CloseButton">
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="ui|FAContentDialog:primary:close /template/ Button#PrimaryButton">
    <Setter Property="Grid.Column" Value="2" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>

  <Style Selector="ui|FAContentDialog:primary:secondary /template/ Button#SecondaryButton">
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="ui|FAContentDialog:primary:secondary /template/ Button#PrimaryButton">
    <Setter Property="Grid.Column" Value="2" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>

  <Style Selector="ui|FAContentDialog:secondary:close /template/ Button#CloseButton">
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="ui|FAContentDialog:secondary:close /template/ Button#SecondaryButton">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Grid.Column" Value="2" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>

  <Style Selector="ui|FAContentDialog:primary:secondary:close /template/ Button#CloseButton">
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="ui|FAContentDialog:primary:secondary:close /template/ Button#SecondaryButton">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
    <Setter Property="Margin" Value="4,0,4,0" />
  </Style>
  <Style Selector="ui|FAContentDialog:primary:secondary:close /template/ Button#PrimaryButton">
    <Setter Property="Grid.Column" Value="3" />
    <Setter Property="Grid.ColumnSpan" Value="1" />
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>
</Styles>
