<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Scanwise.App.Views"
        x:Class="Scanwise.App.Views.HelpWindow"
        Title="Scanwise Help"
        Width="760" Height="720" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
  <!-- macOS only: Help ▸ Scanwise Help opens this window instead of replacing the workspace. -->
  <v:HelpView />
</Window>
