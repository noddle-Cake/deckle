<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Scanwise.App.Views.Dialogs.ScanMergeDialog"
             Width="420">
  <StackPanel Spacing="12">
    <TextBlock TextWrapping="Wrap">Insert newly scanned pages between the existing ones. Use this to scan two-sided documents without a duplex scanner: scan all front sides first, then the back sides with this option.</TextBlock>
    <StackPanel Spacing="4">
      <TextBlock Classes="heading">Insert the first new page after</TextBlock>
      <ComboBox x:Name="StartBox" HorizontalAlignment="Stretch" />
    </StackPanel>
    <CheckBox x:Name="ReverseBox" IsChecked="True">
      <TextBlock TextWrapping="Wrap">New pages come in reverse order (the stack was flipped over)</TextBlock>
    </CheckBox>
    <Border Classes="card">
      <StackPanel Spacing="4">
        <TextBlock Classes="caption">Result</TextBlock>
        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
