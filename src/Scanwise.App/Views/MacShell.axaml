<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:Scanwise.App.Controls"
             xmlns:vm="using:Scanwise.App.ViewModels"
             xmlns:svc="using:Scanwise.App.Services"
             x:Class="Scanwise.App.Views.MacShell"
             x:DataType="vm:MainViewModel">
  <!--
    The macOS window: the title bar and toolbar are one row (Toolbars HIG), and the scan options are a full-height
    sidebar whose column stays transparent so the window's vibrancy shows through (Sidebars, Materials).
    Toolbar groups, at most three: leading = sidebar button and document title; centre = common page actions;
    trailing = Share and Scan, the one prominent button. MainWindow puts its usual content in BodyHost.
  -->
  <Grid x:Name="Root" RowDefinitions="52,*">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource ContentBackground}" />

    <!-- Sidebar part of the title bar: the traffic lights sit at its leading edge. -->
    <Panel x:Name="SidebarTitleArea" Grid.Row="0" Grid.Column="0" Background="Transparent">
      <Button Classes="icon" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
              Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="{svc:ShortcutTip 'Hide sidebar', ToggleSidebar}"
              AutomationProperties.Name="Hide sidebar">
        <c:LucideIcon Kind="PanelLeft" />
      </Button>
    </Panel>

    <Grid x:Name="Toolbar" Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="8,0,12,0"
          Background="Transparent">
      <!-- Leading: show the sidebar again, then the document title. -->
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Classes="icon" Command="{Binding ToggleSidebarCommand}" IsVisible="{Binding ShowToolbarSidebarButton}"
                ToolTip.Tip="{svc:ShortcutTip 'Show or hide sidebar', ToggleSidebar}" AutomationProperties.Name="Show or hide sidebar">
          <c:LucideIcon Kind="PanelLeft" />
        </Button>
        <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
          <TextBlock Text="{Binding WindowTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260" />
          <TextBlock Classes="caption" Text="{Binding Pages.SelectionSummary}" Margin="0,-2,0,0">
            <TextBlock.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="HasPages" />
                <Binding Path="!IsBusy" />
              </MultiBinding>
            </TextBlock.IsVisible>
          </TextBlock>
          <!-- Progress: scanning, saving, importing. -->
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}" Margin="0,1,0,0">
            <TextBlock Classes="caption" Text="{Binding BusyText}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <ProgressBar Width="90" MinWidth="0" Height="4" MinHeight="4" VerticalAlignment="Center"
                         IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding Progress}" Maximum="100" />
            <Button Classes="icon" Padding="2" Command="{Binding CancelOperationCommand}" IsVisible="{Binding CanCancel}"
                    ToolTip.Tip="{svc:ShortcutTip Stop, Cancel}" AutomationProperties.Name="Stop">
              <c:LucideIcon Kind="X" FontSize="12" />
            </Button>
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!-- Pages | Editor, when the window has room for only one of them. -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                  IsVisible="{Binding !PagesPaneIsColumn}">
        <ToggleButton Classes="segment" Content="Pages" IsChecked="{Binding IsPagesShown, Mode=OneWay}"
                      Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Section.Pages}" CornerRadius="6,0,0,6" />
        <ToggleButton Classes="segment" Content="Editor" IsChecked="{Binding IsEditorShown, Mode=OneWay}"
                      Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Section.Editor}" CornerRadius="0,6,6,0" />
      </StackPanel>

      <!-- Centre: common actions on the selected pages. -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2"
                  IsEnabled="{Binding HasPages}" IsVisible="{Binding ShowToolbarActions}" ClipToBounds="True">
        <Button Classes="icon" Command="{Binding Pages.RotateLeftCommand}" ToolTip.Tip="{svc:ShortcutTip 'Rotate left', RotateLeft}" AutomationProperties.Name="Rotate left">
          <c:LucideIcon Kind="RotateCcw" />
        </Button>
        <Button Classes="icon" Command="{Binding Pages.RotateRightCommand}" ToolTip.Tip="{svc:ShortcutTip 'Rotate right', RotateRight}" AutomationProperties.Name="Rotate right">
          <c:LucideIcon Kind="RotateCw" />
        </Button>
        <Border Width="12" />
        <ToggleButton Classes="icon" Command="{Binding CropPageCommand}" IsChecked="{Binding Editor.IsCropping, Mode=OneWay}" ToolTip.Tip="Crop" AutomationProperties.Name="Crop">
          <c:LucideIcon Kind="Crop" />
        </ToggleButton>
        <ToggleButton Classes="icon" Command="{Binding AdjustPageCommand}" IsChecked="{Binding Editor.IsAdjusting, Mode=OneWay}" ToolTip.Tip="Adjust colors, brightness and straighten" AutomationProperties.Name="Adjust">
          <c:LucideIcon Kind="SlidersHorizontal" />
        </ToggleButton>
        <ToggleButton Classes="icon" Command="{Binding DrawOnPageCommand}" IsChecked="{Binding Editor.IsDrawing, Mode=OneWay}" ToolTip.Tip="Draw and highlight" AutomationProperties.Name="Draw">
          <c:LucideIcon Kind="Highlighter" />
        </ToggleButton>
      </StackPanel>

      <!-- Trailing: Share, then Scan as the one primary action. -->
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="icon" Command="{Binding ShareCommand}" IsEnabled="{Binding HasPages}" ToolTip.Tip="Share selected pages, or all pages" AutomationProperties.Name="Share">
          <c:LucideIcon Kind="Share" />
        </Button>
        <SplitButton Classes="accent" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}"
                     ToolTip.Tip="{svc:ShortcutTip Scan, Scan}" AutomationProperties.Name="Scan">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:LucideIcon Kind="ScanLine" FontSize="16" />
            <TextBlock Text="Scan" FontWeight="SemiBold" />
          </StackPanel>
          <SplitButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Scan and Add to Current Document" Command="{Binding ScanAddToDocumentCommand}" />
              <MenuItem Header="Scan into New Document" Command="{Binding ScanStartFreshCommand}" InputGesture="{svc:Shortcut ScanNew}" />
              <MenuItem Header="Scan and Insert Between Pages…" Command="{Binding ScanMergeCommand}" />
              <Separator />
              <MenuItem Header="Batch Scan…" Command="{Binding BatchScanCommand}" />
            </MenuFlyout>
          </SplitButton.Flyout>
        </SplitButton>
      </StackPanel>
    </Grid>

    <ContentControl x:Name="BodyHost" Grid.Row="1" Grid.ColumnSpan="2" />
  </Grid>
</UserControl>
