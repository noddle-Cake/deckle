<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Scanwise.App.ViewModels"
             xmlns:svc="using:Scanwise.App.Services"
             xmlns:c="using:Scanwise.App.Controls"
             xmlns:m="using:Scanwise.App.Models"
             x:Class="Scanwise.App.Views.EditorView"
             x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,*" DataContext="{Binding Editor}" x:DataType="vm:EditorViewModel" Background="{DynamicResource CanvasBackground}">

    <!-- Toolbar -->
    <Border Grid.Row="0" Padding="8,6" Background="{DynamicResource BarBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="icon" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanGoPrevious}" ToolTip.Tip="{svc:ShortcutTip 'Previous page', PreviousPage}">
            <c:LucideIcon Kind="ChevronLeft" />
          </Button>
          <TextBlock Text="{Binding PageTitle}" VerticalAlignment="Center" Margin="6,0" MinWidth="110" TextAlignment="Center" />
          <Button Classes="icon" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" ToolTip.Tip="{svc:ShortcutTip 'Next page', NextPage}">
            <c:LucideIcon Kind="ChevronRight" />
          </Button>
        </StackPanel>

        <!-- On macOS these are in the window toolbar and the Page menu. -->
        <WrapPanel Grid.Column="1" HorizontalAlignment="Center" IsEnabled="{Binding HasPage}" IsVisible="{x:Static svc:PlatformLook.HasPaneActions}">
          <Button Classes="icon" Command="{Binding RotateLeftCommand}" ToolTip.Tip="Rotate left">
            <c:LucideIcon Kind="RotateCcw" />
          </Button>
          <Button Classes="icon" Command="{Binding RotateRightCommand}" ToolTip.Tip="Rotate right">
            <c:LucideIcon Kind="RotateCw" />
          </Button>
          <Button Classes="icon" Command="{Binding Rotate180Command}" ToolTip.Tip="Rotate 180°">
            <TextBlock Text="180°" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Button>
          <ToggleButton Classes="icon" Padding="8" Background="Transparent" BorderThickness="0" Command="{Binding StartCropCommand}" IsChecked="{Binding IsCropping, Mode=OneWay}" ToolTip.Tip="Crop">
            <c:LucideIcon Kind="Crop" FontSize="18" />
          </ToggleButton>
          <ToggleButton Classes="icon" Padding="8" Background="Transparent" BorderThickness="0" Command="{Binding StartAdjustCommand}" IsChecked="{Binding IsAdjusting, Mode=OneWay}" ToolTip.Tip="Adjust colors, brightness and straighten">
            <c:LucideIcon Kind="SlidersHorizontal" FontSize="18" />
          </ToggleButton>
          <ToggleButton Classes="icon" Padding="8" Background="Transparent" BorderThickness="0" Command="{Binding StartDrawCommand}" IsChecked="{Binding IsDrawing, Mode=OneWay}" ToolTip.Tip="Draw and highlight">
            <c:LucideIcon Kind="Highlighter" FontSize="18" />
          </ToggleButton>
          <Button Classes="icon" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CopyPageCommand}" ToolTip.Tip="{svc:ShortcutTip 'Copy page to clipboard', Copy}">
            <c:LucideIcon Kind="Copy" />
          </Button>
          <Button Classes="icon" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShareCommand}" ToolTip.Tip="{svc:ShortcutTip Share, Share}">
            <c:LucideIcon Kind="Share" />
          </Button>
          <Button Classes="icon" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete page">
            <c:LucideIcon Kind="Trash2" />
          </Button>
        </WrapPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding HasPage}">
          <Button Classes="icon" Command="{Binding ZoomOutCommand}" ToolTip.Tip="{svc:ShortcutTip 'Zoom out', ZoomOut}">
            <c:LucideIcon Kind="ZoomOut" />
          </Button>
          <Button Classes="icon" Command="{Binding ZoomFitCommand}" ToolTip.Tip="{svc:ShortcutTip 'Fit to window', ZoomFit}" MinWidth="52">
            <TextBlock Text="{Binding ZoomLabel}" FontSize="12" />
          </Button>
          <Button Classes="icon" Command="{Binding ZoomInCommand}" ToolTip.Tip="{svc:ShortcutTip 'Zoom in', ZoomIn}">
            <c:LucideIcon Kind="ZoomIn" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <!-- Page -->
      <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Viewbox Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Margin="16"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill" IsVisible="{Binding HasPage}">
          <Border BoxShadow="0 2 10 0 #50000000">
            <Grid Width="{Binding PreviewPixels.Width}" Height="{Binding PreviewPixels.Height}">
              <!-- Drag the page out to another app or a folder. Crop and draw sit on top and take the pointer. -->
              <Image x:Name="PageImage" Source="{Binding Preview}" Stretch="Fill" />
              <c:CropOverlay IsVisible="{Binding IsCropping}"
                             LeftEdge="{Binding CropLeft}" TopEdge="{Binding CropTop}"
                             RightEdge="{Binding CropRight}" BottomEdge="{Binding CropBottom}"
                             AspectRatio="{Binding LockedAspect}" DisplayScale="{Binding EffectiveZoom}" />
              <c:InkCanvas IsVisible="{Binding IsDrawing}" Strokes="{Binding Strokes}"
                           InkColor="{Binding SelectedInkColor}" InkWidth="{Binding SelectedInkWidth}"
                           IsHighlighter="{Binding IsHighlighter}" />
            </Grid>
          </Border>
        </Viewbox>
      </ScrollViewer>

      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsVisible="{Binding !HasPage}">
        <c:LucideIcon Kind="Image" FontSize="44" Opacity="0.4" />
        <TextBlock Text="Select a page to view and edit it" Opacity="0.7" />
      </StackPanel>

      <ui:ProgressRing Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                       IsIndeterminate="True" IsVisible="{Binding IsRendering}" />

      <!-- Tool panel -->
      <Border Grid.Column="1" Width="280" IsVisible="{Binding IsToolOpen}" Background="{DynamicResource PaneBackground}"
              BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer>
            <StackPanel Margin="16" Spacing="14">
              <!-- Crop -->
              <StackPanel Spacing="12" IsVisible="{Binding IsCropping}">
                <TextBlock Classes="title" Text="Crop" />
                <StackPanel Spacing="6">
                  <TextBlock Classes="heading" Text="Aspect ratio" />
                  <Grid ColumnDefinitions="*,Auto">
                    <ComboBox ItemsSource="{Binding AspectRatios}" SelectedItem="{Binding AspectRatio}" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Classes="icon" Margin="4,0,0,0" Command="{Binding FlipAspectCommand}" ToolTip.Tip="Switch portrait / landscape">
                      <c:LucideIcon Kind="RotateCcwSquare" />
                    </Button>
                  </Grid>
                </StackPanel>
                <CheckBox IsChecked="{Binding CropSimilarPages}">
                  <StackPanel>
                    <TextBlock Text="Crop similar pages" />
                    <TextBlock Classes="caption" Text="Apply the same crop to every page with this page's size." />
                  </StackPanel>
                </CheckBox>
                <TextBlock Classes="caption" Text="Drag the handles, or drag inside the page to draw a new area." />
              </StackPanel>

              <!-- Draw -->
              <StackPanel Spacing="12" IsVisible="{Binding IsDrawing}">
                <TextBlock Classes="title" Text="Draw" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <RadioButton GroupName="ink" Content="Pen" IsChecked="{Binding IsPen}" />
                  <RadioButton GroupName="ink" Content="Highlighter" IsChecked="{Binding IsHighlighter}" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Classes="heading" Text="Color" />
                  <ListBox Classes="swatches" ItemsSource="{Binding InkColors}" SelectedItem="{Binding InkColor}" Background="Transparent">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="m:InkColorOption">
                        <Ellipse Width="22" Height="22" ToolTip.Tip="{Binding Label}" Stroke="#40000000" StrokeThickness="1" Fill="{Binding Brush}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Classes="heading" Text="Thickness" />
                  <ComboBox ItemsSource="{Binding InkWidths}" SelectedItem="{Binding InkWidth}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Undo stroke" Command="{Binding UndoStrokeCommand}" IsEnabled="{Binding HasStrokes}" />
                  <Button Content="Clear" Command="{Binding ClearStrokesCommand}" IsEnabled="{Binding HasStrokes}" />
                </StackPanel>
                <TextBlock Classes="caption" Text="Drawing is added to the page image when you apply it. Undo removes it again afterwards." />
              </StackPanel>

              <!-- Adjust -->
              <StackPanel Spacing="10" IsVisible="{Binding IsAdjusting}">
                <TextBlock Classes="title" Text="Adjust" />
                <StackPanel>
                  <TextBlock Text="Straighten" />
                  <Slider Minimum="-30" Maximum="30" Value="{Binding Straighten}" ToolTip.Tip="Half-degree steps" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Brightness" />
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Contrast" />
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Saturation" />
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Saturation}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Hue" />
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Hue}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Sharpen" />
                  <Slider Minimum="0" Maximum="100" Value="{Binding Sharpen}" />
                </StackPanel>
                <CheckBox Content="Grayscale" IsChecked="{Binding Grayscale}" />
                <CheckBox Content="Black and white" IsChecked="{Binding BlackAndWhite}" />
                <StackPanel IsVisible="{Binding BlackAndWhite}">
                  <TextBlock Text="Threshold" />
                  <Slider Minimum="-100" Maximum="100" Value="{Binding BlackWhiteThreshold}" />
                </StackPanel>
                <CheckBox Content="Apply to all selected pages" IsChecked="{Binding AdjustSelectedPages}" />
                <Button Content="Reset" Command="{Binding ResetAdjustCommand}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="1" Margin="16,8,16,16" ColumnDefinitions="*,8,*">
            <Button Grid.Column="0" HorizontalAlignment="Stretch" Content="Cancel" Command="{Binding CancelToolCommand}" />
            <Button Grid.Column="2" HorizontalAlignment="Stretch" Classes="accent" Content="Apply"
                    Command="{Binding ApplyCropCommand}" IsVisible="{Binding IsCropping}" />
            <Button Grid.Column="2" HorizontalAlignment="Stretch" Classes="accent" Content="Apply"
                    Command="{Binding ApplyAdjustCommand}" IsVisible="{Binding IsAdjusting}" />
            <Button Grid.Column="2" HorizontalAlignment="Stretch" Classes="accent" Content="Apply"
                    Command="{Binding ApplyDrawCommand}" IsVisible="{Binding IsDrawing}" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
