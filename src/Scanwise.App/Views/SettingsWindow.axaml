<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Scanwise.App.ViewModels"
        xmlns:v="using:Scanwise.App.Views"
        x:Class="Scanwise.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="760" Height="720" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
  <!-- macOS only: Settings get their own window (Scanwise ▸ Settings…, ⌘,) instead of a page in the main window. -->
  <v:SettingsView />
</Window>
