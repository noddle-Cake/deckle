<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:svc="using:Scanwise.App.Services">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PaneBackground" Color="#F3F3F3" />
          <!-- Scan options pane and editor bar; MacStyles makes them transparent over the window's vibrancy. -->
          <SolidColorBrush x:Key="SidebarBackground" Color="#F3F3F3" />
          <SolidColorBrush x:Key="BarBackground" Color="#F3F3F3" />
          <!-- Behind pages and editor in the macOS shell. -->
          <SolidColorBrush x:Key="ContentBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBackground" Color="#FBFBFB" />
          <SolidColorBrush x:Key="CardBorder" Color="#1A000000" />
          <SolidColorBrush x:Key="CanvasBackground" Color="#EBEBEB" />
          <SolidColorBrush x:Key="PageShadow" Color="#33000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PaneBackground" Color="#202020" />
          <SolidColorBrush x:Key="SidebarBackground" Color="#202020" />
          <SolidColorBrush x:Key="BarBackground" Color="#202020" />
          <SolidColorBrush x:Key="ContentBackground" Color="#1E1E1E" />
          <SolidColorBrush x:Key="CardBackground" Color="#2B2B2B" />
          <SolidColorBrush x:Key="CardBorder" Color="#19FFFFFF" />
          <SolidColorBrush x:Key="CanvasBackground" Color="#1A1A1A" />
          <SolidColorBrush x:Key="PageShadow" Color="#66000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Section headings in the scan options pane (Scanner's BaseTextBlockStyle). -->
  <Style Selector="TextBlock.heading">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Divider on the scan options pane's trailing edge (a style, so the macOS glass sidebar can drop it). -->
  <Style Selector="Border.sidebar">
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <!-- Rounded cards like Scanner's option groups. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <!-- Compact icon-only toolbar buttons. -->
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icon ui|FontIcon">
    <Setter Property="FontSize" Value="18" />
  </Style>

  <!-- Icon-only buttons are named after their tooltip for screen readers; a local AutomationProperties.Name wins. -->
  <Style Selector=":is(Button).icon">
    <Setter Property="AutomationProperties.Name"
            Value="{Binding $self.(ToolTip.Tip), Converter={x:Static svc:AccessibleName.Instance}}" />
  </Style>
  <Style Selector="ListBox.pages ListBoxItem">
    <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Label}" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem">
    <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Label}" />
  </Style>

  <Style Selector="RadioButton">
    <Setter Property="Margin" Value="0,0,0,-4" />
  </Style>

  <!-- Thumbnail tiles in the page list. -->
  <Style Selector="ListBox.pages ListBoxItem">
    <Setter Property="Padding" Value="6" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.swatches ListBoxItem">
    <Setter Property="Padding" Value="5" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
</Styles>
